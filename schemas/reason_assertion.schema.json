{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/reasoned-mmp/reason-assertion.schema.json",
  "title": "Medicinal chemistry design assertion",
  "type": "object",
  "required": [
    "reason_id",
    "child_chembl_id",
    "assertion_class",
    "reason_statement",
    "evidence",
    "intended_property",
    "required_added_features",
    "required_removed_features"
  ],
  "properties": {
    "reason_id": {"type": "string"},
    "child_chembl_id": {"type": "string", "pattern": "^CHEMBL[0-9]+$"},
    "assertion_class": {
      "enum": [
        "explicit_prospective_intent",
        "explicit_feature_choice_with_sar_basis",
        "explicit_series_rationale",
        "implied_intent",
        "retrospective_explanation",
        "generic_sar",
        "no_rationale"
      ]
    },
    "reason_statement": {"type": "string"},
    "intended_property": {
      "type": "object",
      "required": ["name", "direction", "explicitness"],
      "properties": {
        "name": {"type": "string"},
        "direction": {"enum": ["increase", "decrease", "maintain", "modulate", "unspecified"]},
        "explicitness": {"enum": ["explicit", "inferred", "not_stated"]}
      }
    },
    "required_added_features": {"type": "array", "items": {"type": "string"}},
    "required_removed_features": {"type": "array", "items": {"type": "string"}},
    "evidence": {
      "type": "object",
      "required": ["document_id", "path", "line_start", "line_end", "access_quality", "entailment_status"],
      "properties": {
        "document_id": {"type": "string"},
        "path": {"type": "string"},
        "line_start": {"type": "integer"},
        "line_end": {"type": "integer"},
        "verbatim_excerpt": {"type": "string"},
        "access_quality": {"enum": ["full_text", "abstract_only", "supplement_only", "ocr", "unavailable"]},
        "entailment_status": {"enum": ["entailed", "partial", "not_entailed", "unreviewed"]}
      }
    },
    "explicit_parent_chembl_id": {"type": ["string", "null"]},
    "extraction_confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": true
}
